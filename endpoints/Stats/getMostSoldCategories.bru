meta {
  name: getMostSoldCategories
  type: http
  seq: 1
}

post {
  url: {{api_url}}stats/getMostSoldCategories/?access_token={{access_token}}&{{enable_debug}}
  body: formUrlEncoded
  auth: none
}

params:query {
  access_token: {{access_token}}
  {{enable_debug}}:
}

body:json {
  {
    "company_id": "{{company_id}}"
    "vat_values": ""
    "category_id": ""
  }
}

body:form-urlencoded {
  company_id: {{company_id}}
  vat_values:
  category_id:
}

